# Copy to .env and fill in only the providers you use. Never commit .env.

# Only these providers may be called (comma separated). Empty: every configured one.
OPENPEOPLEROUTER_PROVIDERS=
# Providers to try first, in this order.
OPENPEOPLEROUTER_ORDER=
# Required to serve HTTP beyond localhost.
OPENPEOPLEROUTER_TOKEN=

# Akta — https://akta.pro/pricing
AKTA_API_KEY=
# Anymailfinder — https://anymailfinder.com/pricing
ANYMAILFINDER_API_KEY=
# Apify — https://apify.com/pricing
APIFY_TOKEN=
# Apollo — https://docs.apollo.io/docs/api-pricing
APOLLO_API_KEY=
# BlitzAPI — https://blitz-api.ai/pricing
BLITZAPI_API_KEY=
# BounceBan — https://bounceban.com/pricing
BOUNCEBAN_API_KEY=
# Bouncer — https://www.usebouncer.com/pricing
BOUNCER_API_KEY=
